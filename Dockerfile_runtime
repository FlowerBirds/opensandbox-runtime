# Minimal runtime image: official Python 3.12 slim (Debian 12 base).
# No Java/Maven/Go/Node, no Jupyter/ipykernel, no conda.

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 1. Install common tools. No build-essential (we only install from wheels via
#    --only-binary=:all: below), so no C compiler toolchain is needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl file jq procps tree unzip zip tar \
    && rm -rf /var/lib/apt/lists/*

# 2. Install common Python dependencies (kept in its own layer for cache reuse).
#    --only-binary=:all: requires wheels for every package — source builds
#    would fail without a compiler, so failing loudly here is preferable.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade --no-cache-dir pip setuptools wheel && \
    pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# 3. Drop bytecode caches left behind by the pip install above.
RUN find /usr/local/lib/python3.12 -type d -name "__pycache__" -exec rm -rf {} + \
    && find /usr/local/lib/python3.12 -name "*.pyc" -delete

WORKDIR /workspace

CMD ["python"]
