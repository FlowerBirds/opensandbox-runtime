# Minimal runtime image: Ubuntu 24.04 + common tools + Python 3.12 only.
# No Java/Maven/Go/Node, no Jupyter/ipykernel.

FROM ubuntu:24.04

ARG TARGETARCH

# Use bash for RUN commands to support source and arrays
SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12 \
    UV_PYTHON_INSTALL_DIR=/opt/python/versions \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 1. Install common tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git vim nano unzip zip tar build-essential \
    software-properties-common gnupg lsb-release \
    && rm -rf /var/lib/apt/lists/*

# 2. Install uv and Python 3.12
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/uvx /usr/local/bin/uvx && \
    mkdir -p /opt/python/versions && \
    uv python install ${PYTHON_VERSION}

# 3. Resolve the actual Python 3.12 install path and put it on PATH.
#    uv's Python ships with pip3; alias `pip` to pip3 for convenience.
RUN PYTHON_BIN_DIR=$(find /opt/python/versions -maxdepth 1 -type d -name "cpython-${PYTHON_VERSION}*" | sort -V | tail -n 1)/bin && \
    ln -sf "${PYTHON_BIN_DIR}/python3" /usr/local/bin/python3 && \
    ln -sf "${PYTHON_BIN_DIR}/python3" /usr/local/bin/python && \
    ln -sf "${PYTHON_BIN_DIR}/pip3" /usr/local/bin/pip3 && \
    ln -sf "${PYTHON_BIN_DIR}/pip3" /usr/local/bin/pip

# 4. Install common Python dependencies with uv (kept in its own layer for
#    cache reuse). uv is ~10-100x faster than pip and defaults to wheels.
COPY requirements.txt /tmp/requirements.txt
RUN uv pip install --system --no-cache -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

WORKDIR /workspace

CMD ["python3"]
