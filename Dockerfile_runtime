# Minimal runtime image: official Python 3.12 slim (Debian 12 base).
# No Java/Maven/Go/Node, no Jupyter/ipykernel, no conda.

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LD_LIBRARY_PATH=/opt/dpi:${LD_LIBRARY_PATH}

# 1. Install common tools. No build-essential (we only install from wheels via
#    --only-binary=:all: below), so no C compiler toolchain is needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl file jq procps tree unzip zip tar \
    && rm -rf /var/lib/apt/lists/*

# 2. Install common Python dependencies (kept in its own layer for cache reuse).
#    --only-binary=:all: requires wheels for every package — source builds
#    would fail without a compiler, so failing loudly here is preferable.
#    When PRIVATE_PYPI_URL is set, also install tempo_oi from the private index
#    in the same RUN (no extra layer). Credentials come from a BuildKit secret
#    mounted at /run/secrets/pypi_password — never persisted in any image layer.
COPY requirements.txt /tmp/requirements.txt
ARG PRIVATE_PYPI_URL=""
ARG PRIVATE_PYPI_USERNAME=""
RUN --mount=type=secret,id=pypi_password \
    pip install --upgrade --no-cache-dir pip setuptools wheel && \
    pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements.txt && \
    if [ -n "${PRIVATE_PYPI_URL}" ]; then \
        HOST="${PRIVATE_PYPI_URL#http://}"; \
        HOST="${HOST#https://}"; \
        TRUSTED_HOST="${HOST%%:*}"; \
        pip install --only-binary=:all: --no-cache-dir \
            --index-url https://pypi.org/simple \
            --extra-index-url "http://${PRIVATE_PYPI_USERNAME}:$(cat /run/secrets/pypi_password)@${HOST}/simple" \
            --trusted-host "${TRUSTED_HOST}" \
            tempo_oi; \
    fi && \
    rm /tmp/requirements.txt

# 3. Drop bytecode caches left behind by the pip install above.
RUN find /usr/local/lib/python3.12 -type d -name "__pycache__" -exec rm -rf {} + \
    && find /usr/local/lib/python3.12 -name "*.pyc" -delete

# 4. Install DPI shared libraries (unzipped to /opt so /opt/dpi lands on LD_LIBRARY_PATH).
COPY dpi.zip /tmp/dpi.zip
RUN set -eux; \
    unzip -o /tmp/dpi.zip -d /opt; \
    rm -f /tmp/dpi.zip

WORKDIR /workspace

CMD ["python"]
