# Minimal runtime image: official Python 3.12 slim (Debian 12 base).
# No Java/Maven/Go, no Jupyter/ipykernel, no conda.

FROM python:3.12-slim

# LD_LIBRARY_PATH=/opt/dpi:${LD_LIBRARY_PATH}  # 已停用：DPI 共享库不再随镜像安装
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/python/pkgs \
    NODE_ROOT=/opt/node \
    NODE_V22=22.23.5

# 1. Install common tools. No build-essential (we only install from wheels via
#    --only-binary=:all: below), so no C compiler toolchain is needed.
#    libatomic1/libstdc++6 are required by the node binary (step 2); the slim
#    base image ships neither, and without them node aborts with
#    "error while loading shared libraries: libatomic.so.1".
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl file jq procps tree unzip zip tar \
    libatomic1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Node.js 22 (LTS). The upstream tarball is used rather than a
#    distro package so the version matches what users expect. The .tar.gz
#    variant is used because the slim image has no xz-utils.
#    PATH is set before the install so the sanity checks below can run node
#    and npm (npm's shebang needs node on PATH).
ENV PATH="${NODE_ROOT}/v${NODE_V22}/bin:${PATH}"

ARG TARGETARCH
RUN set -eux; \
    ARCH=""; \
    if [ -z "${TARGETARCH}" ]; then \
        case "$(uname -m)" in \
            x86_64) TARGETARCH="amd64" ;; \
            aarch64) TARGETARCH="arm64" ;; \
            *) echo "Unsupported architecture: $(uname -m)"; exit 1 ;; \
        esac; \
    fi; \
    case "${TARGETARCH}" in \
        "amd64") ARCH="x64" ;; \
        "arm64") ARCH="arm64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    mkdir -p "${NODE_ROOT}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_V22}/node-v${NODE_V22}-linux-${ARCH}.tar.gz" \
        | tar -xz -C "${NODE_ROOT}"; \
    mv "${NODE_ROOT}/node-v${NODE_V22}-linux-${ARCH}" "${NODE_ROOT}/v${NODE_V22}"; \
    node --version; \
    npm --version

# 3. Install common Python dependencies (kept in its own layer for cache reuse).
#    --only-binary=:all: requires wheels for every package — source builds
#    would fail without a compiler, so failing loudly here is preferable.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade --no-cache-dir pip setuptools wheel && \
    pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# 4. Drop bytecode caches left behind by the pip install above.
RUN find /usr/local/lib/python3.12 -type d -name "__pycache__" -exec rm -rf {} + \
    && find /usr/local/lib/python3.12 -name "*.pyc" -delete

# 5. Install DPI shared libraries. The zip lives in the `dpi` release asset
#    (see https://github.com/FlowerBirds/opensandbox-runtime/releases/tag/dpi);
#    downloading at build time keeps dpi.zip out of the build context and out
#    of git. Override DPI_RELEASE_URL via --build-arg to point at a mirror.
#    已停用：DPI 共享库不再随镜像安装，需要时再启用以下内容。
# ARG DPI_RELEASE_URL=https://github.com/FlowerBirds/opensandbox-runtime/releases/download/dpi/dpi.zip
# RUN set -eux; \
#     curl -fsSL -o /tmp/dpi.zip "${DPI_RELEASE_URL}"; \
#     unzip -o /tmp/dpi.zip -d /opt; \
#     rm -f /tmp/dpi.zip

# 6. Startup hooks. The entrypoint installs every wheel found in
#    /opt/install/pkgs (normally a mounted directory) before handing over to
#    the container command, so frequently updated packages can be delivered
#    without rebuilding the image. With nothing mounted the install step is a
#    no-op and the container behaves exactly as before.
COPY scripts/install-pkgs.sh scripts/runtime-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/install-pkgs.sh /usr/local/bin/runtime-entrypoint.sh \
    && mkdir -p /opt/install/pkgs

# 7. Chinese fonts. The archive lives in the `Chinese_fonts` release asset
#    (see https://github.com/FlowerBirds/opensandbox-runtime/releases/tag/Chinese_fonts);
#    downloading at build time keeps the zip out of the build context and out
#    of git. Override CHINESE_FONTS_URL via --build-arg to point at a mirror.
#
#    fc-cache comes from the fontconfig package, which is the Debian
#    equivalent of the `yum install mkfontscale / fontconfig` route (this
#    image is Debian-based, not RPM-based). The tools are on PATH already, so
#    no `source /etc/profile` is needed.
#    Only fc-cache is called: Debian 13 (trixie) dropped mkfontscale and
#    mkfontdir from the fontconfig package, and they only generate the
#    legacy fonts.dir/fonts.scale files that pre-1990s X clients look for —
#    fontconfig itself reads the cache fc-cache writes.
ARG CHINESE_FONTS_URL=https://github.com/FlowerBirds/opensandbox-runtime/releases/download/Chinese_fonts/Chinese_fonts.zip
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends fontconfig; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /usr/share/fonts/chinese; \
    curl -fsSL -o /tmp/Chinese_fonts.zip "${CHINESE_FONTS_URL}"; \
    unzip -o /tmp/Chinese_fonts.zip -d /usr/share/fonts/chinese; \
    rm -f /tmp/Chinese_fonts.zip; \
    find /usr/share/fonts/chinese -type f \( -name '*.ttf' -o -name '*.ttc' -o -name '*.otf' \) \
        -exec chmod 755 {} +; \
    if [ -z "$(find /usr/share/fonts/chinese -type f \( -name '*.ttf' -o -name '*.ttc' -o -name '*.otf' \) -print -quit)" ]; then \
        echo "no font files found in ${CHINESE_FONTS_URL}" >&2; exit 1; \
    fi; \
    cd /usr/share/fonts/chinese; \
    fc-cache -fv

# 8. LibreOffice and the Python UNO bridge.
#    soffice --headless converts office documents (docx/xlsx/pptx -> pdf).
#    * The `libreoffice` metapackage pulls in writer/calc/impress/draw/math
#      plus the GUI flavour of libreoffice-core — Debian's document modules
#      depend on it, so the X11/GTK libraries come along even though no
#      display is ever used.
#    * --no-install-recommends drops the language packs and the
#      Java/Basic/JavaScript script providers; the Python script provider is
#      added explicitly because python3-uno needs it for the bridge to work.
#    * python3-uno is compiled against the distro's own Python (Debian 13
#      ships 3.13, Debian 12 ships 3.11), never against the image's 3.12:
#      pyuno is a CPython extension module and its ABI is version-locked.
#      So the interpreter that can `import uno` is derived from the package
#      dependency at build time and exposed as /usr/local/bin/uno-python.
#      The image's default python stays 3.12 (/usr/local/bin/python3).
#    * The fonts are the metric-compatible ones for MS Office documents
#      (Carlito/Caladea for Calibri/Cambria, Liberation for Arial/Times).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libreoffice \
        libreoffice-script-provider-python \
        python3-uno \
        fonts-dejavu-core \
        fonts-liberation \
        fonts-crosextra-carlito \
        fonts-crosextra-caladea \
    ; \
    rm -rf /var/lib/apt/lists/*; \
    UNO_PY="/usr/bin/$(dpkg-query -W -f='${Depends}' python3-uno \
        | tr ' ,' '\n\n' | grep -oE '^python3\.[0-9]+' | head -n1)"; \
    test -f "${UNO_PY}"; \
    printf '#!/bin/sh\nexec %s "$@"\n' "${UNO_PY}" > /usr/local/bin/uno-python; \
    chmod +x /usr/local/bin/uno-python; \
    HOME=/root timeout 120 soffice --version; \
    "${UNO_PY}" -c "import uno; print('pyuno OK:', uno.__file__)"; \
    /usr/local/bin/uno-python -c "import uno; print('uno-python OK')"

# 9. WeasyPrint (HTML/CSS -> PDF).
#    * The Debian `weasyprint` package is bound to the distro's Python (3.13
#      on trixie), so its module cannot be imported by the image's 3.12 — the
#      same ABI lock as the pyuno bridge. WeasyPrint itself is pure Python,
#      so the image's own 3.12 takes the module from PyPI (see
#      requirements.txt) and only the native side (pango, fontconfig, the
#      MIME database) has to come from apt.
#    * The pip console script lands in /usr/local/bin, which precedes
#      /usr/bin on PATH, so `weasyprint in.html out.pdf` runs under 3.12.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        weasyprint \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        shared-mime-info \
    ; \
    rm -rf /var/lib/apt/lists/*; \
    python -c "import weasyprint; print('weasyprint OK:', weasyprint.__version__)"; \
    weasyprint --version; \
    printf '<html><body><h1>weasyprint smoke test</h1></body></html>' > /tmp/smoke.html; \
    weasyprint /tmp/smoke.html /tmp/smoke.pdf; \
    test -s /tmp/smoke.pdf; \
    rm -f /tmp/smoke.html /tmp/smoke.pdf

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/runtime-entrypoint.sh"]
CMD ["python"]
