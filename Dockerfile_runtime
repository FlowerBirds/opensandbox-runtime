# Minimal runtime image: Ubuntu 24.04 + common tools + Python via miniforge3.
# No Java/Maven/Go/Node, no Jupyter/ipykernel.

FROM ubuntu:24.04

ARG TARGETARCH
# Miniforge3 ships a Python 3.12 toolchain out of the box; override with
# --build-arg MINIFORGE_VERSION=<ver> to pin a different release.
ARG MINIFORGE_VERSION=25.3.1-0

# Use bash for RUN commands to support source and arrays
SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 1. Install common tools. No build-essential: we only install from wheels
#    (see --only-binary=:all: in step 4), so no C compiler toolchain is needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git vim nano unzip zip tar \
    software-properties-common gnupg lsb-release \
    && rm -rf /var/lib/apt/lists/*

# 2. Install miniforge3 (Conda-forge distribution with Python 3.12).
#    Miniforge picks the right arch-specific installer based on TARGETARCH.
#    After install we strip the conda tooling itself — we only need the
#    Python runtime + pip, so `conda install` is not required:
#      - conda clean -afy     clears the downloaded package cache (pkgs)
#      - rm conda-meta/envs   drops the conda metadata / env scaffolding
#      - rm bin/conda, mamba  removes the conda commands
#      - rm /root/.conda      drops conda user config
#    python, pip and site-packages under /usr/local/miniforge3 stay intact.
RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) MINIFORGE_ARCH="x86_64"   ;; \
        arm64) MINIFORGE_ARCH="aarch64"  ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac && \
    wget -q "https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-${MINIFORGE_VERSION}-Linux-${MINIFORGE_ARCH}.sh" \
        -O /tmp/miniforge.sh && \
    chmod +x /tmp/miniforge.sh && \
    /tmp/miniforge.sh -b -p /usr/local/miniforge3 && \
    /usr/local/miniforge3/bin/conda clean -afy && \
    rm -rf /usr/local/miniforge3/conda-meta \
           /usr/local/miniforge3/envs \
           /usr/local/miniforge3/bin/conda \
           /usr/local/miniforge3/bin/mamba \
           /usr/local/miniforge3/bin/conda-shell \
           /root/.conda && \
    rm /tmp/miniforge.sh

# 3. Put miniforge3 (python, pip, conda) on PATH ahead of system binaries.
ENV PATH="/usr/local/miniforge3/bin:${PATH}"

# 4. Install common Python dependencies (kept in its own layer for cache reuse).
#    --only-binary=:all: requires wheels for every package. This is safe because
#    build-essential was removed in step 1, so source builds would fail anyway;
#    failing loudly here is clearer than failing silently later at runtime.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade --no-cache-dir pip setuptools wheel && \
    pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

WORKDIR /workspace

CMD ["python"]
